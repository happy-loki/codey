{
    "name": "codey",
    "version": "0.0.52",
    "type": "module",
    "private": true,
    "scripts": {
        "prebuild": "echo 'Build preparation'",
        "build": "vite build",
        "dev": "cross-env SASS_SILENCE_DEPRECATIONS=legacy-js-api vite",
        "start": "vite preview",
        "check": "svelte-check --workspace . --tsconfig ./tsconfig.json --config ./vite.config.ts",
        "check:ci": "node scripts/check-type-baseline.mjs",
        "check:baseline:update": "node scripts/check-type-baseline.mjs --update-baseline",
        "tauri": "tauri",
        "start-window": "yarn tauri dev --features devtools",
        "tauri-build-debug": "yarn build && cargo build --manifest-path src-tauri/Cargo.toml",
        "tauri-build": "yarn build && yarn tauri build",
        "codex:protocol:generate": "node scripts/generate-codex-protocol.mjs",
        "sync:version": "node scripts/sync-version.mjs"
    },
