{
  "build": {
    "beforeBuildCommand": "yarn build",
    "beforeDevCommand": "yarn dev",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8080"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "category": "DeveloperTool",
    "copyright": "",
    "targets": [
      "dmg"
    ],
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "infoPlist": "Info.plist",
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "codey",
  "mainBinaryName": "codey",
  "version": "0.0.50",
  "identifier": "com.lokizhou.codey",
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "os": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NTQ1NDQ4NDg2RTJDNzYKUldSMkxHNUlTRlJVS1N3eC9XTDRlcGVob1hQMEZHNmk4R2hqUnd3azM0TTJGVjhyUlRaN1F4ZHoK",
      "endpoints": [
        "https://github.com/happy-loki/codey/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Codey",
        "width": 800,
        "minWidth": 680,
        "minHeight": 430,
        "decorations": true,
        "dragDropEnabled": false,
        "maximized": false,
        "visible": false,
        "useHttpsScheme": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "splashscreen",
        "url": "/splashscreen.html",
        "width": 400,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": true,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; img-src 'self' asset: https://asset.localhost http://asset.localhost data: https: blob:; media-src 'self' asset: https://asset.localhost http://asset.localhost data: https: blob:; font-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  }
}
